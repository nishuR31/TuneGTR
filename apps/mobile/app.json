{
  "expo": {
    "name": "Guitar Tuner",
    "slug": "guitar-tuner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Guitar Tuner needs microphone access to detect the pitch of your guitar strings. Audio is processed locally and never recorded or uploaded."
        }
      ]
    ],

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-light.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-foreground-dark.png",
        "darkForegroundImage": "./assets/adaptive-foreground-dark.png",
        "darkBackgroundColor": "#111522"
      },
      "package": "com.guitartool.tuner",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF1F7",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#111522"
      }
    }
  }
}